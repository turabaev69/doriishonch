# === DoriIshonch production sozlamalari ===
# Domen (DNS A yozuvi server IP siga yoʻnaltirilgan boʻlishi kerak)
DOMAIN=doriishonch.uz
# Kuchli parollar: openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=
SHOW_DEMO_ACCOUNTS=false
ENVIRONMENT=production

# AI (ixtiyoriy, lekin tavsiya etiladi): surat oʻqish, qadoq tekshiruvi, yordamchi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Rasmiy markirovka (Asl Belgisi) — shartnomadan keyin
ASL_BELGISI_BASE_URL=https://xtrace.aslbelgisi.uz
ASL_BELGISI_API_KEY=

# Demo maʼlumotlar (hakamlar uchun true; haqiqiy ishga tushirishda false)
SEED_ON_STARTUP=false

# Telegram bot (ixtiyoriy): docker compose --profile bot ...
TELEGRAM_BOT_TOKEN=
