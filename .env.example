# Nusxa oling: cp .env.example .env

# Claude API kaliti (https://console.anthropic.com). Boʻsh qolsa, AI siz rejim ishlaydi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Mahalliy ishga tushirishda SQLite ishlatiladi; docker-compose Postgres ga ulaydi.
DATABASE_URL=sqlite:///./doriishonch.db
CORS_ORIGINS=http://localhost:3000

# Asl Belgisi xTrace Open API (haqiqiy markirovka maʼlumotlari). Kalit boʻlmasa, demo baza.
# Kalit: aslbelgisi.uz shaxsiy kabineti → Profil → Tashkilot → Foydalanuvchilar → API kalitlar
ASL_BELGISI_BASE_URL=https://xtrace.stage.aslbelgisi.uz
ASL_BELGISI_API_KEY=

# Bojxona tizimi API (rasmiy kelishuvdan keyin). Boʻsh boʻlsa demo manba.
CUSTOMS_API_URL=
CUSTOMS_API_TOKEN=

# Telegram bot (ixtiyoriy): @BotFather dan token oling
TELEGRAM_BOT_TOKEN=
